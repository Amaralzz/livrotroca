# Copie para .env e preencha. Nunca envie o .env para o GitHub.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# MySQL
DB_NAME=livrotroca
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# E-mail: o console mostra os e-mails no terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=livrotroca@naoresponda.com

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
